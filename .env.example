# OIDC Reverse Proxy Configuration
# Copy this file to .env and fill in your OIDC provider details

# Domain for the application (e.g., localhost:8443 for testing)
DOMAIN=localhost:8443

# OIDC Client ID from your provider
OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com

# OIDC Client Secret from your provider
OIDC_CLIENT_SECRET=your-client-secret

# Crypto passphrase for session encryption (generate with: openssl rand -hex 32)
OIDC_CRYPTO_PASSPHRASE=change-this-to-a-random-64-character-string

# OIDC Provider JWKS URI (JSON Web Key Set)
# Google: https://www.googleapis.com/oauth2/v3/certs
# Azure AD: https://login.microsoftonline.com/{tenant}/discovery/v2.0/keys
# Okta: https://{your-okta-domain}/oauth2/default/v1/keys
# Auth0: https://{your-auth0-domain}/.well-known/jwks.json
OIDC_PROVIDER_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs

# OIDC Provider Metadata URL (OpenID Connect Discovery)
# Google: https://accounts.google.com/.well-known/openid-configuration
# Azure AD: https://login.microsoftonline.com/{tenant}/v2.0/.well-known/openid-configuration
# Okta: https://{your-okta-domain}/oauth2/default/.well-known/openid-configuration
# Auth0: https://{your-auth0-domain}/.well-known/openid-configuration
OIDC_PROVIDER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration

# Note: Redirect URI should be registered as: https://{DOMAIN}/oidc/callback
# For local testing: https://localhost:8443/oidc/callback

# OIDC claim to use for remote user (usually 'email' or 'sub')
OIDC_REMOTE_USER=email

# Port for OIDC proxy to listen on
PORT=8443

# Scheme (http or https)
SCHEME=https

# Upstream target (vnc-proxy container)
# Format: http://container-name:port
UPSTREAM=http://vnc-proxy:8080

# VNC Proxy Application Configuration

# Authentication mode (e.g., OIDC, BASIC, NONE)
AUTH_MODE=OIDC

# AWS Configuration for DynamoDB (dynamic-config mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# DynamoDB table name for host configuration
CONFIG_TABLE=vnc-hosts

# Guacamole daemon host (guacd container name)
GUACD_HOST=guacd
